# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

use_modular_headers!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'rnshowcase' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # One Firebase app per build configuration, mirroring android/app/src/<buildType>/google-services.json.
  # Declared here rather than added in Xcode so it is reproducible from source control, and positioned
  # :before_compile because Crashlytics' upload-symbols reads the plist out of the built bundle — it must
  # already be the right one by the time [CP-User] [RNFB] Crashlytics Configuration runs.
  script_phase :name => 'Select GoogleService-Info.plist',
               :execution_position => :before_compile,
               :input_files => ['$(SRCROOT)/firebase/$(CONFIGURATION)/GoogleService-Info.plist'],
               :output_files => ['$(BUILT_PRODUCTS_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/GoogleService-Info.plist'],
               :script => <<~SH
                 set -eu

                 src="${SRCROOT}/firebase/${CONFIGURATION}/GoogleService-Info.plist"
                 dest="${BUILT_PRODUCTS_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/GoogleService-Info.plist"

                 [ -f "$src" ] || { echo "error: no GoogleService-Info.plist for configuration ${CONFIGURATION} at $src" >&2; exit 1; }

                 plist_id=$(/usr/libexec/PlistBuddy -c "Print :BUNDLE_ID" "$src")
                 [ "$plist_id" = "$PRODUCT_BUNDLE_IDENTIFIER" ] || { echo "error: $src is registered to $plist_id, this build is $PRODUCT_BUNDLE_IDENTIFIER" >&2; exit 1; }

                 mkdir -p "$(dirname "$dest")"
                 cp "$src" "$dest"
               SH

  target 'rnshowcaseTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
