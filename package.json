{
  "name": "rn-showcase",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android --appIdSuffix debug",
    "ios": "react-native run-ios",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:ci": "jest src/__tests__ --no-coverage",
    "types:api": "spec=\"$(./scripts/api-spec.sh)\" && openapi-typescript \"$spec\" --output src/data/dto/generated/schema.d.ts",
    "types:check": "npm run types:api && git diff --exit-code -- src/data/dto/generated/schema.d.ts"
  },
  "dependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-syntax-decorators": "^7.29.7",
    "@mkdigitalsk/design-system": "2.1.1",
    "@notifee/react-native": "^9.1.8",
    "@op-engineering/op-sqlite": "^19.0.5",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/slider": "^5.2.2",
    "@react-native-firebase/app": "^27.1.1",
    "@react-native-firebase/crashlytics": "^27.1.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "axios": "^1.21.1",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-biometrics": "^3.0.1",
    "react-native-calendars": "^1.1314.0",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-image-picker": "^8.3.0",
    "react-native-localize": "^3.7.2",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-paper": "^5.15.4",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-share": "^12.3.1",
    "react-native-svg": "^15.16.1",
    "react-native-torch": "^1.2.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-vision-camera": "^5.2.4",
    "react-native-vision-camera-barcode-scanner": "^5.2.4",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/runtime": "^7.29.14",
    "@jest/globals": "^29.7.0",
    "@jest/types": "^29.6.3",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "babel-jest": "^29.7.0",
    "babel-plugin-transform-typescript-metadata": "^0.4.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.10.1",
    "test-renderer": "^1.3.1",
    "ts-jest": "^29.4.15",
    "ts-mockito": "^2.6.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
